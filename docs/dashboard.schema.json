{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wikibento.toolforge.org/schemas/dashboard.schema.json",
  "title": "WikiBento Dashboard Config",
  "description": "Dashboard configuration format for WikiBento (v1). The app's authoritative runtime validator is src/lib/dashboardConfig.js (validateDashboard) — this schema is the structural spec for external tooling; per-field strictness lives in the runtime validator.",
  "type": "object",
  "required": [
    "widgets",
    "layout"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Format version. Absent is treated as 1."
    },
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/widget"
      }
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/layoutItem"
      }
    }
  },
  "definitions": {
    "widget": {
      "type": "object",
      "required": [
        "id",
        "widgetType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "widgetType": {
          "type": "string",
          "enum": [
            "pageviews",
            "linkcount",
            "categorySize",
            "wikistats",
            "fileUsage",
            "glamorgan",
            "topWikipedias",
            "topPages",
            "markdown",
            "qrCode",
            "excerpt",
            "edithistory",
            "quality",
            "assessments",
            "gallery",
            "articleList",
            "cimStats",
            "cimTrend",
            "cimRanking",
            "boardControls",
            "speaker",
            "wikiBox",
            "wikiPage",
            "translate",
            "sparql",
            "map",
            "panorama360",
            "mediaPlayer",
            "waybackGallery",
            "iaItem",
            "iaBook",
            "documentReader",
            "listSource",
            "filterLines",
            "lineCount",
            "echo",
            "commonsGallery",
            "fileGallery",
            "cimSnapshot",
            "cimFileSpotlight",
            "cimFileTraffic",
            "cimTopFiles",
            "cimTopWikis",
            "cimTopPages",
            "cimTopEditors",
            "cimLeaderboard"
          ],
          "description": "Every widget type the app resolves, current types first. The trailing ids are RETIRED types: a board that carries one still loads, because the app resolves it to the type that replaced it (src/widgets/index.js → widgetDef), so an old board stays valid against this schema."
        },
        "config": {
          "type": "object",
          "properties": {
            "refreshSeconds": {
              "type": "number",
              "minimum": 30
            },
            "_title": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "description": "Per-widget config. Field vocabulary per widgetType is enforced by the runtime validator (see docs/JSON-FORMAT.md); unknown keys tolerated."
        }
      },
      "additionalProperties": false
    },
    "layoutItem": {
      "type": "object",
      "required": [
        "i",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "i": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 1,
          "maximum": 12
        },
        "h": {
          "type": "number",
          "minimum": 1
        },
        "minW": {
          "type": "number",
          "minimum": 1
        },
        "minH": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
