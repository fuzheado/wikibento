# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.playwright-cli/

# esbuild test bundles (generated by `npm test`, deleted after the run)
*-test-bundle.mjs

# E2E screenshots are evidence for a run, not repo content
*-e2e.png

# Local cache of fetched API responses (cache-first fetching: never commit payloads)
cache/

# Throwaway probes written while debugging (a hypothesis, a fixed URL, a screenshot). They belong in the session,
# not the repo — four of them landed in a commit on 2026-09-16 and were removed the same day. Durable versions go in
# scripts/ (see scripts/browser-matrix.mjs, whose --demos sweep grew out of exactly such a probe).
tmp-*
