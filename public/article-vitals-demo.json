{
  "version": 1,
  "params": {
    "article": {
      "label": "Article",
      "type": "buttons",
      "options": [
        "Albert Einstein",
        "Marie Curie",
        "Ada Lovelace",
        "Cleopatra"
      ],
      "value": "Albert Einstein"
    }
  },
  "widgets": [
    {
      "id": "note",
      "widgetType": "markdown",
      "config": {
        "text": "# 🔎 Article vitals\n\nOne article, six angles — all follow the **Article** buttons: summary and traffic, ORES quality, WikiProject assessments, the latest edits, and the images the article uses.\n\nUseful before an edit, a cleanup pass, or a story pitch.",
        "refreshSeconds": 86400
      }
    },
    {
      "id": "pick",
      "widgetType": "boardControls",
      "config": {
        "title": "Pick an article",
        "show": "article",
        "refreshSeconds": 86400
      }
    },
    {
      "id": "excerpt",
      "widgetType": "excerpt",
      "config": {
        "article": "{{article}}",
        "project": "en.wikipedia",
        "refreshSeconds": 3600
      }
    },
    {
      "id": "views",
      "widgetType": "pageviews",
      "config": {
        "article": "{{article}}",
        "project": "en.wikipedia",
        "displayMode": "trend",
        "refreshSeconds": 3600
      }
    },
    {
      "id": "quality",
      "widgetType": "quality",
      "config": {
        "article": "{{article}}",
        "project": "en.wikipedia",
        "refreshSeconds": 3600
      }
    },
    {
      "id": "assessments",
      "widgetType": "assessments",
      "config": {
        "article": "{{article}}",
        "project": "en.wikipedia",
        "topN": 8,
        "refreshSeconds": 3600
      }
    },
    {
      "id": "edits",
      "widgetType": "edithistory",
      "config": {
        "article": "{{article}}",
        "project": "en.wikipedia",
        "limit": 10,
        "refreshSeconds": 3600
      }
    },
    {
      "id": "images",
      "widgetType": "gallery",
      "config": {
        "article": "{{article}}",
        "project": "en.wikipedia",
        "displayMode": "grid",
        "iconSize": "medium",
        "minSize": 200,
        "maxItems": 0,
        "refreshSeconds": 3600
      }
    }
  ],
  "layout": [
    {
      "i": "note",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 3,
      "minW": 3,
      "minH": 2
    },
    {
      "i": "pick",
      "x": 0,
      "y": 3,
      "w": 3,
      "h": 4,
      "minW": 2,
      "minH": 2
    },
    {
      "i": "excerpt",
      "x": 3,
      "y": 3,
      "w": 4,
      "h": 5,
      "minW": 3,
      "minH": 3
    },
    {
      "i": "views",
      "x": 7,
      "y": 3,
      "w": 5,
      "h": 5,
      "minW": 3,
      "minH": 3
    },
    {
      "i": "quality",
      "x": 0,
      "y": 8,
      "w": 3,
      "h": 5,
      "minW": 2,
      "minH": 3
    },
    {
      "i": "assessments",
      "x": 3,
      "y": 8,
      "w": 4,
      "h": 5,
      "minW": 3,
      "minH": 3
    },
    {
      "i": "edits",
      "x": 7,
      "y": 8,
      "w": 5,
      "h": 5,
      "minW": 3,
      "minH": 3
    },
    {
      "i": "images",
      "x": 0,
      "y": 13,
      "w": 12,
      "h": 6,
      "minW": 4,
      "minH": 3
    }
  ]
}
